{
  "entities": {
    "Lobby": {
      "title": "Lobby",
      "description": "A public chat lobby linked to a location.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the lobby (the neighborhood or topic)." },
        "lat": { "type": "number", "description": "Latitude of the lobby location." },
        "lng": { "type": "number", "description": "Longitude of the lobby location." },
        "creatorId": { "type": "string", "description": "UID of the user who created the lobby." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the lobby was created." }
      },
      "required": ["name", "lat", "lng", "creatorId", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A message sent within a lobby.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "Content of the message." },
        "senderId": { "type": "string", "description": "UID of the sender." },
        "senderName": { "type": "string", "description": "Display name of the sender." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the message was sent." },
        "isAi": { "type": "boolean", "description": "Whether the message was generated by the AI bot." }
      },
      "required": ["text", "senderId", "senderName", "createdAt"]
    }
  },
  "firestore": {
    "lobbies": {
      "schema": "Lobby",
      "description": "Collection of all active public lobbies."
    },
    "lobbies/{lobbyId}/messages": {
      "schema": "Message",
      "description": "Subcollection of messages for a specific lobby."
    }
  }
}
